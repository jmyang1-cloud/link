// Cloudflare configuration for the standalone deployment.
// The site is static: everything under dist/ is served as-is, with no server code.
{
  "name": "link",
  "compatibility_date": "2026-05-01",
  // Public address. The workers.dev address stays on as a fallback.
  "routes": [{ "pattern": "link.airecipe.co.kr", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
